# ===========================================
# Ollama Signal Bot — configuration
# ===========================================
# Recommended: run `python setup.py` to generate this file interactively.
# You only need to edit this by hand if you prefer to skip the helper.

# The bot's Signal phone number (optional — auto-detected after linking).
# Leave empty to auto-detect from the linked Signal account.
SIGNAL_PHONE_NUMBER=

# Ollama server URL (optional). Defaults to the bundled Docker Ollama.
#   http://ollama:11434               = Docker Ollama (zero-config, default)
#   http://host.docker.internal:11434 = your host's Ollama
OLLAMA_URL=http://ollama:11434

# Model to use (leave empty to auto-detect the first available model).
OLLAMA_MODEL=

# Sampling temperature for generation (0.0-1.0, default 0.7).
OLLAMA_TEMPERATURE=0.7

# Custom system prompt for the AI.
SYSTEM_PROMPT=You are a helpful assistant.

# Who can use the bot: * = everyone, or comma-separated phone numbers.
ALLOWED_SENDERS=*

# Who can run privileged commands (/model, /maxhistory, /config):
# * = every allowed sender (default), or comma-separated phone numbers.
ALLOWED_ADMINS=*

# Web UI (optional):
#   WEBUI_TOKEN — a secret required to use the web UI. Leave empty for no
#                 auth (the UI is bound to localhost by default).
#   WEBUI_PORT   — the host port for the web UI (default 8000).
WEBUI_TOKEN=
WEBUI_PORT=8000
